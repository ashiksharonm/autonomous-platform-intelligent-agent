# --- LLM (all optional: with no key the deterministic mock planner is used) ---
# LLM_PROVIDER=auto            # auto | groq | gemini | mock
GROQ_API_KEY=                  # free tier: https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=                # free tier: https://aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub ---
# GITHUB_MODE=live             # live | mock (mock = in-memory fake repo, no token)
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-scratch-repo

AGENT_DB_PATH=data/agent_memory.sqlite
